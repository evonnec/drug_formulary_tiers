# Local development settings. Copy to .env, which git ignores:
#   cp .env.example .env
# docker compose reads .env on its own; pass it to the CLI and tests with
#   uv run --env-file .env formulary-tiers 3
# These passwords are for the local database only, which is published on
# 127.0.0.1. Use your own values anywhere else.

# Postgres superuser, used once by db/01-init.sh to create the app role.
POSTGRES_PASSWORD=postgres

# The role and database db/01-init.sh creates and the solutions connect as.
APP_DB_USER=appuser
APP_DB_PASS=appuser
APP_DB_NAME=formulary

DATABASE_URL=postgresql+psycopg://appuser:appuser@localhost:5432/formulary

# Runs the Postgres tests (tests/test_postgres.py and the Postgres variants).
TEST_DATABASE_URL=postgresql+psycopg://appuser:appuser@localhost:5432/formulary
